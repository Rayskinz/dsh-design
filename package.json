{
    "name":  "@rayskinz/dsh-design",
    "version":  "0.9.2",
    "description":  "Make DeepSeek Harness yours: wallpaper and GIF backgrounds (per chat or workspace), sidebar effects, chat colors, fonts incl. dyslexic, bubbles, chat pictures, window borders, sounds, one-click themes, and a pet with Snake, Tetris, 2048, Minesweeper and Pong.",
    "license":  "MIT",
    "author":  "Rayskinz",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/Rayskinz/dsh-design.git"
                   },
    "homepage":  "https://github.com/Rayskinz/dsh-design#readme",
    "keywords":  [
                     "deepseek-harness",
                     "dsh-plugin",
                     "dsh",
                     "theme",
                     "themes",
                     "wallpaper",
                     "background",
                     "gif",
                     "animated-background",
                     "customization",
                     "chat-colors",
                     "sidebar-effects",
                     "window-border",
                     "accent-color",
                     "fonts",
                     "dyslexic-font",
                     "avatars",
                     "chat-bubbles",
                     "sounds",
                     "pet",
                     "virtual-pet",
                     "minigames",
                     "snake",
                     "tetris",
                     "2048",
                     "minesweeper",
                     "pong"
                 ],
    "private":  false,
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./package.json":  "./package.json",
                    "./cordis.patch.yml":  "./cordis.patch.yml"
                },
    "files":  [
                  "lib",
                  "src",
                  "tools",
                  "test",
                  "locale",
                  "docs",
                  "icon.svg",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE",
                  "CHANGELOG.md"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ]
                           }
            },
    "scripts":  {
                    "build":  "node tools/build-client.mjs",
                    "test":  "node tools/build-client.mjs --check \u0026\u0026 node --test test/avatars-host.test.mjs test/design.test.mjs test/family.test.mjs test/fx.test.mjs test/games.test.mjs test/games2.test.mjs test/library.test.mjs test/library-host.test.mjs test/look.test.mjs test/pet2.test.mjs test/themes.test.mjs test/themes-host.test.mjs"
                },
    "bugs":  {
                 "url":  "https://github.com/Rayskinz/dsh-design/issues"
             },
    "publishConfig":  {
                          "access":  "public"
                      }
}
