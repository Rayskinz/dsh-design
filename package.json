{
    "name":  "@rayskinz/dsh-design",
    "version":  "0.9.0",
    "description":  "Rayskinz DSH Design: backgrounds (wallpaper and GIF hub, saved list, per chat or workspace), sidebar effects, chat colors, accent and chat look, a pet with games, and themes, in one Design Options page.",
    "license":  "MIT",
    "author":  "Rayskinz",
    "repository":  {
                       "type":  "git",
                       "url":  "git+https://github.com/rayskinz/dsh-design.git"
                   },
    "homepage":  "https://github.com/rayskinz/dsh-design#readme",
    "keywords":  [
                     "deepseek-harness",
                     "dsh-plugin",
                     "theme",
                     "wallpaper",
                     "gif",
                     "customization"
                 ],
    "private":  false,
    "type":  "module",
    "main":  "lib/index.js",
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./locale/*.json":  "./locale/*.json",
                    "./icon":  "./icon.svg",
                    "./package.json":  "./package.json",
                    "./cordis.patch.yml":  "./cordis.patch.yml"
                },
    "files":  [
                  "lib",
                  "src",
                  "tools",
                  "test",
                  "locale",
                  "docs",
                  "icon.svg",
                  "cordis.patch.yml",
                  "README.md",
                  "LICENSE"
              ],
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "immediately":  true,
                               "inject":  [
                                              "@deepseek-ai/dsh-client-ui-settings"
                                          ]
                           }
            },
    "scripts":  {
                    "build":  "node tools/build-client.mjs",
                    "test":  "node tools/build-client.mjs --check \u0026\u0026 node --test test/design.test.mjs test/games.test.mjs"
                }
}
